# Exceptions to the above gitignore rules
# !/android/app/src/main/java/com/example/stridequest/MainActivity.java
# !/ios/Runner/AppDelegate.swift

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

